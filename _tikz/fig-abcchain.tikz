\begin{tikzpicture}[font=\footnotesize,node distance=0.85cm]
    \node[flowfill,minimum width=3.1cm,minimum height=1.0cm,align=center] (a) {\textbf{Awareness}\\know the rule};
    \node[flowfill,minimum width=3.1cm,minimum height=1.0cm,align=center,right=of a] (b) {\textbf{Behaviour}\\do it, daily};
    \node[flowdark,minimum width=3.1cm,minimum height=1.0cm,align=center,right=of b] (c) {\textbf{Culture}\\it is the norm};
    \draw[arr] (a)--(b) node[midway,above,font=\scriptsize]{the gap};
    \draw[arr] (b)--(c);
  \end{tikzpicture}

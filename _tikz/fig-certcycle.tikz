\begin{tikzpicture}[font=\footnotesize]
    \node[flowfill,minimum width=2.6cm,minimum height=0.85cm,align=center] (s1) at (0,1.5) {\textbf{Stage 1}\\documentation};
    \node[flowfill,minimum width=2.6cm,minimum height=0.85cm,align=center] (s2) at (3.4,0) {\textbf{Stage 2}\\implementation};
    \node[flowdark,minimum width=2.6cm,minimum height=0.85cm,align=center] (ct) at (0,-1.5) {\textbf{Certified}\\three years};
